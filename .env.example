# Selected stack. Keys alone do not enable provider calls.
AGENT_MODEL_MODE=fixture
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=
SPEECH_MODE=fixture

# Optional direct Deepgram alternative (not required for Cloudflare speech):
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_API_KEY=
IMAGE_MODE=fixture
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Live modes: AGENT_MODEL_MODE=openai, SPEECH_MODE=cloudflare, IMAGE_MODE=cloudflare
# Optional alternative image provider: IMAGE_MODE=openai, OPENAI_IMAGE_MODEL=...

LANGSMITH_TRACING=false
LANGGRAPH_CLI_NO_ANALYTICS=1
LANGGRAPH_URL=http://127.0.0.1:2024
WAHA_URL=http://127.0.0.1:3011
# Exact private sender IDs, comma-separated. Use a test sender for live WhatsApp mode.
WAHA_ALLOWED_SENDERS=
# setup generates WAHA_API_KEY, WAHA_WEBHOOK_SECRET, THREAD_SECRET privately.
