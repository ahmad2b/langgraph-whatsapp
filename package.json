{
  "name": "langchain-whatsapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "agent:dev": "node --env-file-if-exists=.env node_modules/@langchain/langgraph-cli/dist/cli/cli.mjs dev --host 127.0.0.1 --port 2024 --no-browser",
    "check": "npm run format:check && tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "adapter": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "whatsapp": "node --env-file-if-exists=.env --import tsx scripts/whatsapp.ts",
    "forget": "node --env-file-if-exists=.env --import tsx scripts/forget.ts",
    "status": "node --env-file-if-exists=.env --import tsx scripts/status.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:install": "npm ci --prefix web",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:check": "npm --prefix web run typecheck && npm --prefix web run lint"
  },
  "dependencies": {
    "@langchain/core": "1.4.2",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-sdk": "1.17.0",
    "@langchain/openai": "1.8.4",
    "langchain": "1.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.8.0",
    "@types/node": "^24.0.0",
    "prettier": "3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
